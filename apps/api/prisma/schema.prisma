generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
  CLIENT
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum AuthProvider {
  OTP
  GOOGLE
}

enum WorkerStatus {
  DRAFT
  PENDING_KYC
  KYC_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SkillStatus {
  ACTIVE
  INACTIVE
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
}

enum OtpStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  LOCKED
}

enum KycReviewDecision {
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletTransactionSource {
  PAYMENT
  REFUND
  BONUS
  ADJUSTMENT
  DEMO
}

model User {
  id     String     @id @default(uuid()) @db.Uuid
  role   UserRole   @default(CLIENT)
  status UserStatus @default(ACTIVE)

  firstName String?
  lastName  String?

  email         String? @unique
  phoneNumber   String? @unique
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  authProvider AuthProvider @default(OTP)
  googleId     String?      @unique

  lastLoginAt DateTime?
  location    UserLocation?

  worker        Worker?
  client        Client?
  wallet        Wallet?
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  kycReviews    WorkerKycReview[] @relation("KycReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Worker {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status WorkerStatus @default(DRAFT)

  profilePhotoKey String?

  aadhaarDocumentKey            String?
  policeVerificationDocumentKey String?

  bio                String?  @db.Text
  experienceYears    Int?
  expectedHourlyRate Decimal? @db.Decimal(10, 2)
  expectedDailyRate  Decimal? @db.Decimal(10, 2)

  isAvailable      Boolean           @default(true)
  skills           WorkerSkill[]
  categories       WorkerCategory[]
  kycReviews       WorkerKycReview[]
  bookingsAsWorker Booking[]         @relation("BookingWorker")

  kycSubmittedAt DateTime?
  verifiedAt     DateTime?
  rejectedAt     DateTime?
  suspendedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isAvailable])
  @@index([createdAt])
}

model WorkerKycReview {
  id String @id @default(uuid()) @db.Uuid

  workerId String @db.Uuid
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  reviewerId String @db.Uuid
  reviewer   User   @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  decision KycReviewDecision?

  rejectionReason String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([reviewerId])
  @@index([decision])
  @@index([createdAt])
}

model WorkerCategory {
  workerId   String @db.Uuid
  categoryId String @db.Uuid

  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([workerId, categoryId])
  @@index([categoryId])
}

model Client {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ClientType @default(INDIVIDUAL)

  companyName     String?
  gstin           String?
  contactPerson   String?
  businessAddress String?   @db.Text
  bookings        Booking[] @relation("BookingClient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([gstin])
  @@index([createdAt])
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  slug        String         @unique
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  skills  Skill[]
  workers WorkerCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

model Skill {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name      String
  slug      String
  status    SkillStatus @default(ACTIVE)
  sortOrder Int         @default(0)

  workers WorkerSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([status])
}

model WorkerSkill {
  workerId String @db.Uuid
  skillId  String @db.Uuid

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([workerId, skillId])
  @@index([skillId])
}

model UserLocation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  accuracyMeters Decimal? @db.Decimal(8, 2)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}

model OtpCode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose OtpPurpose
  status  OtpStatus  @default(ACTIVE)

  codeHash String

  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purpose, status])
  @@index([expiresAt])
  @@index([createdAt])
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Booking {
  id String @id @default(uuid()) @db.Uuid

  clientId String @db.Uuid
  workerId String @db.Uuid

  client Client @relation("BookingClient", fields: [clientId], references: [id], onDelete: Restrict)

  worker Worker @relation("BookingWorker", fields: [workerId], references: [id], onDelete: Restrict)

  status       BookingStatus @default(PENDING)
  categoryId   String?       @db.Uuid
  categoryName String?

  skillId   String? @db.Uuid
  skillName String?

  serviceTitle       String   @db.VarChar(150)
  serviceDescription String?  @db.Text
  hourlyRate         Decimal? @db.Decimal(10, 2)
  dailyRate          Decimal? @db.Decimal(10, 2)
  scheduledStart     DateTime
  scheduledEnd       DateTime

  address   String   @db.Text
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  cancelledAt        DateTime?
  cancelledBy        String?   @db.Uuid
  cancellationReason String?   @db.Text

  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  completedAt DateTime?
  payment     Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([workerId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([createdAt])
  @@index([workerId, status])
  @@index([clientId, status])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String @unique @db.Uuid

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(ONLINE)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  gatewayOrderId   String? @unique
  gatewayPaymentId String? @unique
  gatewaySignature String?

  idempotencyKey String @unique @db.VarChar(100)

  failureCode    String?
  failureMessage String? @db.Text

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([paidAt])
}

model Wallet {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance  Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)
  source WalletTransactionSource

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  referenceId String? @unique
  description String? @db.Text

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}
