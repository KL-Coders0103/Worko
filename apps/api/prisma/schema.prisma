generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
  CLIENT
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum AuthProvider {
  OTP
  GOOGLE
}

enum WorkerStatus {
  DRAFT
  PENDING_KYC
  KYC_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SkillStatus {
  ACTIVE
  INACTIVE
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
}

enum OtpStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  LOCKED
}

enum KycReviewDecision {
  APPROVED
  REJECTED
}

enum RequirementStatus {
  OPEN
  MATCHING
  MATCHED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RequirementAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  SEARCHING
  PENDING
  ACCEPTED
  CONFIRMED
  WORKER_EN_ROUTE
  ARRIVED
  CHECKED_IN
  IN_PROGRESS
  CHECKED_OUT
  COMPLETED
  PAYMENT_RELEASED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletTransactionSource {
  PAYMENT
  REFUND
  BONUS
  ADJUSTMENT
  DEMO
}

enum AttendanceStatus {
  NOT_STARTED
  CHECKED_IN
  IN_PROGRESS
  CHECKED_OUT
  COMPLETED
  FAILED
}

enum AttendanceEventType {
  ARRIVED
  CHECK_IN
  CHECK_OUT
}

enum AttendanceEvidenceType {
  BEFORE_PHOTO
  AFTER_PHOTO
}

enum AttendanceQrPurpose {
  CHECK_IN
  CHECK_OUT
}

enum ReelStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  REJECTED
  DELETED
}

enum ReelLikeStatus {
  ACTIVE
  REMOVED
}

model User {
  id     String     @id @default(uuid()) @db.Uuid
  role   UserRole   @default(CLIENT)
  status UserStatus @default(ACTIVE)

  firstName String?
  lastName  String?

  email         String? @unique
  phoneNumber   String? @unique
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  authProvider AuthProvider @default(OTP)
  googleId     String?      @unique

  lastLoginAt DateTime?
  location    UserLocation?

  worker        Worker?
  client        Client?
  wallet        Wallet?
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  kycReviews    WorkerKycReview[] @relation("KycReviewer")
  reelLikes     ReelLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Worker {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status WorkerStatus @default(DRAFT)

  profilePhotoKey String?

  aadhaarDocumentKey            String?
  policeVerificationDocumentKey String?

  bio                String?  @db.Text
  experienceYears    Int?
  expectedHourlyRate Decimal? @db.Decimal(10, 2)
  expectedDailyRate  Decimal? @db.Decimal(10, 2)

  isAvailable       Boolean           @default(true)
  skills            WorkerSkill[]
  categories        WorkerCategory[]
  kycReviews        WorkerKycReview[]
  bookingsAsWorker  Booking[]         @relation("BookingWorker")
  attendanceRecords Attendance[]
  reels             Reel[]
  requirementAssignments RequirementAssignment[]

  kycSubmittedAt DateTime?
  verifiedAt     DateTime?
  rejectedAt     DateTime?
  suspendedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isAvailable])
  @@index([createdAt])
}

model Reel {
  id String @id @default(uuid()) @db.Uuid

  workerId String @db.Uuid
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  status ReelStatus @default(DRAFT)

  title       String? @db.VarChar(150)
  description String? @db.Text

  videoKey     String
  thumbnailKey String?

  durationSeconds Int?
  fileSizeBytes   BigInt?
  mimeType        String     @db.VarChar(100)
  likes           ReelLike[]

  publishedAt DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([workerId, status])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model ReelLike {
  id String @id @default(uuid()) @db.Uuid

  reelId String @db.Uuid
  reel   Reel   @relation(fields: [reelId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status ReelLikeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reelId, userId])
  @@index([reelId])
  @@index([userId])
  @@index([reelId, status])
}

model WorkerKycReview {
  id String @id @default(uuid()) @db.Uuid

  workerId String @db.Uuid
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  reviewerId String @db.Uuid
  reviewer   User   @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  decision KycReviewDecision?

  rejectionReason String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([reviewerId])
  @@index([decision])
  @@index([createdAt])
}

model WorkerCategory {
  workerId   String @db.Uuid
  categoryId String @db.Uuid

  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([workerId, categoryId])
  @@index([categoryId])
}

model Client {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ClientType @default(INDIVIDUAL)

  companyName     String?
  gstin           String?
  contactPerson   String?
  businessAddress String?   @db.Text
  bookings        Booking[] @relation("BookingClient")
  requirements    Requirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([gstin])
  @@index([createdAt])
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  slug        String         @unique
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  skills  Skill[]
  workers WorkerCategory[]
  requirements Requirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}

model Skill {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name      String
  slug      String
  status    SkillStatus @default(ACTIVE)
  sortOrder Int         @default(0)

  workers WorkerSkill[]
  requirements Requirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([status])
}

model WorkerSkill {
  workerId String @db.Uuid
  skillId  String @db.Uuid

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([workerId, skillId])
  @@index([skillId])
}

model UserLocation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  accuracyMeters Decimal? @db.Decimal(8, 2)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}

model OtpCode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose OtpPurpose
  status  OtpStatus  @default(ACTIVE)

  codeHash String

  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purpose, status])
  @@index([expiresAt])
  @@index([createdAt])
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Requirement {
  id String @id @default(uuid()) @db.Uuid

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  categoryId   String @db.Uuid
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryName String

  skillId   String? @db.Uuid
  skill     Skill? @relation(fields: [skillId], references: [id], onDelete: Restrict)
  skillName String?

  title       String @db.VarChar(150)
  description String? @db.Text
  budget      Decimal? @db.Decimal(12, 2)

  scheduledStart DateTime
  scheduledEnd   DateTime

  address   String @db.Text
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  status RequirementStatus @default(OPEN)

  cancelledAt DateTime?
  cancellationReason String? @db.Text
  completedAt DateTime?

  assignments RequirementAssignment[]
  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([categoryId, status])
  @@index([skillId, status])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([createdAt])
}

model RequirementAssignment {
  id String @id @default(uuid()) @db.Uuid

  requirementId String @db.Uuid
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  workerId String @db.Uuid
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  status RequirementAssignmentStatus @default(OFFERED)
  matchScore Decimal? @db.Decimal(8, 2)
  distanceKm Decimal? @db.Decimal(8, 2)
  respondedAt DateTime?
  responseReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, workerId])
  @@index([workerId, status])
  @@index([requirementId, status])
  @@index([status])
  @@index([createdAt])
}

model Booking {
  id String @id @default(uuid()) @db.Uuid

  clientId String @db.Uuid
  workerId String? @db.Uuid
  requirementId String? @unique @db.Uuid

  client Client @relation("BookingClient", fields: [clientId], references: [id], onDelete: Restrict)

  worker Worker? @relation("BookingWorker", fields: [workerId], references: [id], onDelete: Restrict)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  status       BookingStatus @default(SEARCHING)
  categoryId   String?       @db.Uuid
  categoryName String?

  skillId   String? @db.Uuid
  skillName String?

  serviceTitle       String   @db.VarChar(150)
  serviceDescription String?  @db.Text
  hourlyRate         Decimal? @db.Decimal(10, 2)
  dailyRate          Decimal? @db.Decimal(10, 2)
  scheduledStart     DateTime
  scheduledEnd       DateTime

  address   String   @db.Text
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  cancelledAt        DateTime?
  cancelledBy        String?   @db.Uuid
  cancellationReason String?   @db.Text

  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  completedAt DateTime?
  payment     Payment?
  attendance  Attendance?
  qrTokens    AttendanceQrToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([workerId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([createdAt])
  @@index([workerId, status])
  @@index([clientId, status])
}

model Attendance {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId String @db.Uuid
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  status AttendanceStatus @default(NOT_STARTED)

  checkInAt  DateTime?
  checkOutAt DateTime?

  checkInLatitude   Decimal? @db.Decimal(10, 7)
  checkInLongitude  Decimal? @db.Decimal(10, 7)
  checkOutLatitude  Decimal? @db.Decimal(10, 7)
  checkOutLongitude Decimal? @db.Decimal(10, 7)

  checkInAccuracyMeters  Decimal? @db.Decimal(8, 2)
  checkOutAccuracyMeters Decimal? @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   AttendanceEvent[]
  evidence AttendanceEvidence[]

  @@index([workerId])
  @@index([status])
  @@index([checkInAt])
  @@index([checkOutAt])
}

model AttendanceEvent {
  id String @id @default(uuid()) @db.Uuid

  attendanceId String     @db.Uuid
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  type AttendanceEventType

  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  accuracyMeters Decimal? @db.Decimal(8, 2)

  qrVerified Boolean @default(false)

  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([type])
  @@index([occurredAt])
}

model AttendanceEvidence {
  id String @id @default(uuid()) @db.Uuid

  attendanceId String     @db.Uuid
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  type AttendanceEvidenceType

  storageKey String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  capturedAt DateTime

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([type])
  @@index([capturedAt])
}

model AttendanceQrToken {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  purpose AttendanceQrPurpose

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([bookingId, purpose])
  @@index([expiresAt])
  @@index([usedAt])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String @unique @db.Uuid

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(ONLINE)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  gatewayOrderId   String? @unique
  gatewayPaymentId String? @unique
  gatewaySignature String?

  idempotencyKey String @unique @db.VarChar(100)

  failureCode    String?
  failureMessage String? @db.Text

  paidAt DateTime?

  webhookEvents PaymentWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([paidAt])
}

model Wallet {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance  Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @db.VarChar(200)
  paymentId String @db.Uuid
  type String @db.VarChar(100)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)
  source WalletTransactionSource

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR") @db.VarChar(3)

  referenceId String? @unique
  description String? @db.Text

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}
