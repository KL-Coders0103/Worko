generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  WORKER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthOtpPurpose {
  REGISTRATION
  LOGIN
}

enum WorkerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WorkerAvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum RequirementStatus {
  DRAFT
  PAYMENT_PENDING
  OPEN
  MATCHING
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ReelModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum EngagementType {
  VIEW
  SAVE
  REPORT
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String?          @unique @db.VarChar(320)
  phone           String?          @unique @db.VarChar(20)
  passwordHash    String?          @map("password_hash")
  role            UserRole         @default(CLIENT)
  status          UserStatus       @default(PENDING_VERIFICATION)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workerProfile   WorkerProfile?
  clientProfile   ClientProfile?
  requirements    Requirement[]    @relation("RequirementClient")
  clientBookings  Booking[]        @relation("BookingClient")
  reels           Reel[]
  authOtps        AuthOtp[]
  refreshTokens   RefreshToken[]
  engagements     ReelEngagement[]
  reviewsGiven    Review[]         @relation("ReviewAuthor")
  reviewsReceived Review[]         @relation("ReviewTarget")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}


model ClientProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(160)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?  @db.VarChar(40)
  photoUrl    String?  @map("photo_url") @db.VarChar(2048)
  address     String?  @db.VarChar(500)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@map("client_profiles")
}

model WorkerProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  verificationStatus WorkerVerificationStatus @default(PENDING) @map("verification_status")
  availabilityStatus WorkerAvailabilityStatus @default(OFFLINE) @map("availability_status")
  preferredRadiusKm  Decimal                  @default(10) @map("preferred_radius_km") @db.Decimal(6, 2)
  latitude           Decimal?                 @db.Decimal(10, 7)
  longitude          Decimal?                 @db.Decimal(10, 7)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         WorkerCategory[]
  offers             MatchingOffer[]
  bookings           Booking[]

  @@index([verificationStatus, availabilityStatus])
  @@index([latitude, longitude])
  @@map("worker_profiles")
}

model Category {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique @db.VarChar(100)
  slug         String           @unique @db.VarChar(120)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workers      WorkerCategory[]
  requirements Requirement[]

  @@index([isActive, name])
  @@map("categories")
}

model WorkerCategory {
  workerId   String        @map("worker_id") @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([workerId, categoryId])
  @@index([categoryId, workerId])
  @@map("worker_categories")
}

model Requirement {
  id          String              @id @default(uuid()) @db.Uuid
  clientId    String              @map("client_id") @db.Uuid
  categoryId  String              @map("category_id") @db.Uuid
  title       String              @db.VarChar(160)
  description String              @db.Text
  status      RequirementStatus   @default(DRAFT)
  budget      Decimal?            @db.Decimal(12, 2)
  currency    String              @default("INR") @db.Char(3)
  scheduledAt DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  latitude    Decimal             @db.Decimal(10, 7)
  longitude   Decimal             @db.Decimal(10, 7)
  address     String              @db.VarChar(500)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  client      User                @relation("RequirementClient", fields: [clientId], references: [id], onDelete: Restrict)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers      MatchingOffer[]
  payment     RequirementPayment?
  booking     Booking?

  @@index([clientId, createdAt])
  @@index([status, categoryId, createdAt])
  @@index([status, scheduledAt])
  @@map("requirements")
}

model MatchingOffer {
  id            String        @id @default(uuid()) @db.Uuid
  requirementId String        @map("requirement_id") @db.Uuid
  workerId      String        @map("worker_id") @db.Uuid
  status        OfferStatus   @default(PENDING)
  offeredAt     DateTime      @default(now()) @map("offered_at") @db.Timestamptz(3)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  respondedAt   DateTime?     @map("responded_at") @db.Timestamptz(3)
  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  worker        WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([requirementId, workerId])
  @@index([workerId, status, expiresAt])
  @@index([requirementId, status, offeredAt])
  @@map("matching_offers")
}

model RequirementPayment {
  id                String               @id @default(uuid()) @db.Uuid
  requirementId     String               @unique @map("requirement_id") @db.Uuid
  status            PaymentStatus        @default(PENDING)
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR") @db.Char(3)
  providerReference String?              @unique @map("provider_reference") @db.VarChar(180)
  idempotencyKey    String               @unique @map("idempotency_key") @db.VarChar(180)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  requirement       Requirement          @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  transactions      PaymentTransaction[]

  @@index([status, createdAt])
  @@map("requirement_payments")
}

model Booking {
  id            String                 @id @default(uuid()) @db.Uuid
  requirementId String                 @unique @map("requirement_id") @db.Uuid
  clientId      String                 @map("client_id") @db.Uuid
  workerId      String                 @map("worker_id") @db.Uuid
  status        BookingStatus          @default(CONFIRMED)
  startedAt     DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  requirement   Requirement            @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  client        User                   @relation("BookingClient", fields: [clientId], references: [id], onDelete: Restrict)
  worker        WorkerProfile          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  statusHistory BookingStatusHistory[]
  reviews       Review[]

  @@index([clientId, status, createdAt])
  @@index([workerId, status, createdAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  note      String?       @db.VarChar(500)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model PaymentTransaction {
  id                   String             @id @default(uuid()) @db.Uuid
  requirementPaymentId String             @map("requirement_payment_id") @db.Uuid
  status               PaymentStatus
  amount               Decimal            @db.Decimal(12, 2)
  providerReference    String?            @unique @map("provider_reference") @db.VarChar(180)
  idempotencyKey       String             @unique @map("idempotency_key") @db.VarChar(180)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  payment              RequirementPayment @relation(fields: [requirementPaymentId], references: [id], onDelete: Restrict)

  @@index([requirementPaymentId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  rating    Int
  comment   String?  @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
  @@index([bookingId])
  @@map("reviews")
}

model Reel {
  id               String               @id @default(uuid()) @db.Uuid
  creatorId        String               @map("creator_id") @db.Uuid
  mediaUrl         String               @map("media_url") @db.VarChar(2048)
  caption          String?              @db.VarChar(2200)
  moderationStatus ReelModerationStatus @default(PENDING) @map("moderation_status")
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  creator          User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  engagements      ReelEngagement[]

  @@index([moderationStatus, publishedAt])
  @@index([creatorId, createdAt])
  @@map("reels")
}

model ReelEngagement {
  id        String         @id @default(uuid()) @db.Uuid
  reelId    String         @map("reel_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EngagementType
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  reel      Reel           @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId, type])
  @@index([userId, type, createdAt])
  @@index([reelId, type, createdAt])
  @@map("reel_engagements")
}

model AuthOtp {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  destination String         @db.VarChar(320)
  purpose     AuthOtpPurpose
  codeHash    String         @map("code_hash") @db.VarChar(64)
  attempts    Int            @default(0)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?      @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otps")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
