generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  WORKER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthOtpPurpose {
  REGISTRATION
  LOGIN
}

enum WorkerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WorkerAvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum RequirementStatus {
  DRAFT
  PAYMENT_PENDING
  OPEN
  MATCHING
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum MatchingRoundStatus {
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum BookingPaymentStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  COMMISSION
  ADJUSTMENT
}

enum NotificationType {
  BOOKING
  PAYMENT
  CHAT
  REVIEW
  DISPUTE
  SYSTEM
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ReelModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum EngagementType {
  VIEW
  SAVE
  REPORT
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String?          @unique @db.VarChar(320)
  phone           String?          @unique @db.VarChar(20)
  passwordHash    String?          @map("password_hash")
  role            UserRole         @default(CLIENT)
  status          UserStatus       @default(PENDING_VERIFICATION)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(3)
  deletionScheduledAt DateTime? @map("deletion_scheduled_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workerProfile   WorkerProfile?
  clientProfile   ClientProfile?
  requirements    Requirement[]    @relation("RequirementClient")
  requirementDrafts RequirementDraft[]
  clientBookings  Booking[]        @relation("BookingClient")
  reels           Reel[]
  challengeParticipations ChallengeParticipation[]
  authOtps        AuthOtp[]
  refreshTokens   RefreshToken[]
  wallets         Wallet[]
  chatMessagesSent ChatMessage[]
  notifications   Notification[]
  disputesReported Dispute[]
  engagements     ReelEngagement[]
  reelComments    ReelComment[]
  reviewsGiven    Review[]         @relation("ReviewAuthor")
  reviewsReceived Review[]         @relation("ReviewTarget")
  notificationPreference NotificationPreference?
  pushDevices PushDevice[]
  notificationDeliveries NotificationDelivery[]
  supportTickets SupportTicket[]
  auditLogs AuditLog[]
  safetyAlerts SafetyAlert[]
  challengesCreated Challenge[] @relation("ChallengeCreator")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}


model ClientProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(160)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?  @db.VarChar(40)
  photoUrl    String?  @map("photo_url") @db.VarChar(2048)
  address     String?  @db.VarChar(500)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@map("client_profiles")
}

model WorkerProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  verificationStatus WorkerVerificationStatus @default(PENDING) @map("verification_status")
  displayName         String?                  @map("display_name") @db.VarChar(160)
  photoUrl            String?                  @map("photo_url") @db.VarChar(2048)
  availabilityStatus WorkerAvailabilityStatus @default(OFFLINE) @map("availability_status")
  preferredRadiusKm  Decimal                  @default(10) @map("preferred_radius_km") @db.Decimal(6, 2)
  serviceAreaAddress String?                  @map("service_area_address") @db.VarChar(500)
  serviceAreaLatitude Decimal?                @map("service_area_latitude") @db.Decimal(10, 7)
  serviceAreaLongitude Decimal?               @map("service_area_longitude") @db.Decimal(10, 7)
  minimumPayment     Decimal?                 @map("minimum_payment") @db.Decimal(12, 2)
  workSchedule       Json?                    @map("work_schedule")
  latitude           Decimal?                 @db.Decimal(10, 7)
  longitude          Decimal?                 @db.Decimal(10, 7)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         WorkerCategory[]
  offers             MatchingOffer[]
  bookings           Booking[]

  @@index([verificationStatus, availabilityStatus])
  @@index([latitude, longitude])
  @@map("worker_profiles")
}

model Category {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique @db.VarChar(100)
  slug         String           @unique @db.VarChar(120)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workers      WorkerCategory[]
  requirements Requirement[]

  @@index([isActive, name])
  @@map("categories")
}

model WorkerCategory {
  workerId   String        @map("worker_id") @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([workerId, categoryId])
  @@index([categoryId, workerId])
  @@map("worker_categories")
}

model Requirement {
  id          String              @id @default(uuid()) @db.Uuid
  clientId    String              @map("client_id") @db.Uuid
  categoryId  String              @map("category_id") @db.Uuid
  title       String              @db.VarChar(160)
  description String              @db.Text
  photos      String[]            @default([])
  preferences Json?
  status      RequirementStatus   @default(DRAFT)
  budget      Decimal?            @db.Decimal(12, 2)
  currency    String              @default("INR") @db.Char(3)
  scheduledAt DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  latitude    Decimal             @db.Decimal(10, 7)
  longitude   Decimal             @db.Decimal(10, 7)
  address     String              @db.VarChar(500)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  client      User                @relation("RequirementClient", fields: [clientId], references: [id], onDelete: Restrict)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers      MatchingOffer[]
  matchingRounds MatchingRound[]
  payment     RequirementPayment?
  booking     Booking?

  @@index([clientId, createdAt])
  @@index([status, categoryId, createdAt])
  @@index([status, scheduledAt])
  @@map("requirements")
}

model RequirementDraft {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @unique @map("client_id") @db.Uuid
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("requirement_drafts")
}

model MatchingRound {
  id            String              @id @default(uuid()) @db.Uuid
  requirementId String              @map("requirement_id") @db.Uuid
  roundNumber   Int                 @map("round_number")
  radiusKm      Int                 @map("radius_km")
  status        MatchingRoundStatus @default(ACTIVE)
  startedAt     DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt     DateTime            @map("expires_at") @db.Timestamptz(3)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(3)
  requirement   Requirement         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offers        MatchingOffer[]

  @@unique([requirementId, roundNumber])
  @@index([status, expiresAt])
  @@map("matching_rounds")
}

model MatchingOffer {
  id            String        @id @default(uuid()) @db.Uuid
  requirementId String        @map("requirement_id") @db.Uuid
  workerId      String        @map("worker_id") @db.Uuid
  roundId       String?       @map("round_id") @db.Uuid
  status        OfferStatus   @default(PENDING)
  offeredAt     DateTime      @default(now()) @map("offered_at") @db.Timestamptz(3)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  respondedAt   DateTime?     @map("responded_at") @db.Timestamptz(3)
  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  worker        WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)
  round         MatchingRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([requirementId, workerId])
  @@index([workerId, status, expiresAt])
  @@index([requirementId, status, offeredAt])
  @@map("matching_offers")
}

model RequirementPayment {
  id                String               @id @default(uuid()) @db.Uuid
  requirementId     String               @unique @map("requirement_id") @db.Uuid
  status            PaymentStatus        @default(PENDING)
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR") @db.Char(3)
  providerReference String?              @unique @map("provider_reference") @db.VarChar(180)
  providerOrderId   String?              @unique @map("provider_order_id") @db.VarChar(180)
  idempotencyKey    String               @unique @map("idempotency_key") @db.VarChar(180)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  requirement       Requirement          @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  transactions      PaymentTransaction[]

  @@index([status, createdAt])
  @@map("requirement_payments")
}

model Booking {
  id            String                 @id @default(uuid()) @db.Uuid
  requirementId String                 @unique @map("requirement_id") @db.Uuid
  clientId      String                 @map("client_id") @db.Uuid
  workerId      String                 @map("worker_id") @db.Uuid
  status        BookingStatus          @default(CONFIRMED)
  startedAt     DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  workflow      Json?
  requirement   Requirement            @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  client        User                   @relation("BookingClient", fields: [clientId], references: [id], onDelete: Restrict)
  worker        WorkerProfile          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  statusHistory BookingStatusHistory[]
  reviews       Review[]
  paymentRecord BookingPayment?
  chatMessages  ChatMessage[]
  notifications Notification[]
  disputes      Dispute[]
  safetyAlerts SafetyAlert[]

  @@index([clientId, status, createdAt])
  @@index([workerId, status, createdAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  note      String?       @db.VarChar(500)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model PaymentTransaction {
  id                   String             @id @default(uuid()) @db.Uuid
  requirementPaymentId String             @map("requirement_payment_id") @db.Uuid
  status               PaymentStatus
  amount               Decimal            @db.Decimal(12, 2)
  providerReference    String?            @unique @map("provider_reference") @db.VarChar(180)
  idempotencyKey       String             @unique @map("idempotency_key") @db.VarChar(180)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  payment              RequirementPayment @relation(fields: [requirementPaymentId], references: [id], onDelete: Restrict)

  @@index([requirementPaymentId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model BookingPayment {
  id              String              @id @default(uuid()) @db.Uuid
  bookingId       String              @unique @map("booking_id") @db.Uuid
  grossAmount     Decimal             @db.Decimal(12, 2)
  commissionRate  Decimal             @default(15) @db.Decimal(5, 2)
  commissionAmount Decimal            @db.Decimal(12, 2)
  workerAmount    Decimal             @db.Decimal(12, 2)
  status          BookingPaymentStatus @default(HELD)
  releaseKey      String              @unique @map("release_key") @db.VarChar(180)
  releasedAt      DateTime?           @map("released_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("booking_payments")
}

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  balance     Decimal  @default(0) @db.Decimal(14, 2)
  currency    String   @default("INR") @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  walletId       String                @map("wallet_id") @db.Uuid
  bookingId      String?               @map("booking_id") @db.Uuid
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(14, 2)
  balanceAfter   Decimal               @map("balance_after") @db.Decimal(14, 2)
  description    String                @db.VarChar(500)
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(180)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet         Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([bookingId, createdAt])
  @@map("wallet_transactions")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  content        String   @db.VarChar(4000)
  attachmentUrls String[] @default([]) @map("attachment_urls")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  bookingId String?          @map("booking_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(180)
  body      String           @db.VarChar(1000)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([bookingId, createdAt])
  @@map("notifications")
}

model Dispute {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  reporterId  String   @map("reporter_id") @db.Uuid
  reason      String   @db.VarChar(120)
  description String   @db.VarChar(4000)
  status      String   @default("OPEN") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reporter    User    @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([reporterId, status, createdAt])
  @@map("disputes")
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.VarChar(180)
  eventType String   @map("event_type") @db.VarChar(120)
  payload   Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([eventType, receivedAt])
  @@map("payment_webhook_events")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  rating    Int
  comment   String?  @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
  @@index([bookingId])
  @@map("reviews")
}

model Reel {
  id               String               @id @default(uuid()) @db.Uuid
  creatorId        String               @map("creator_id") @db.Uuid
  mediaUrl         String               @map("media_url") @db.VarChar(2048)
  caption          String?              @db.VarChar(2200)
  moderationStatus ReelModerationStatus @default(PENDING) @map("moderation_status")
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  creator          User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  categoryId       String?              @map("category_id") @db.Uuid
  category         Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  viewCount        Int                  @default(0) @map("view_count")
  likeCount        Int                  @default(0) @map("like_count")
  shareCount       Int                  @default(0) @map("share_count")
  durationSeconds  Int?                 @map("duration_seconds")
  rejectionReason  String?              @map("rejection_reason") @db.VarChar(500)
  engagements      ReelEngagement[]
  comments         ReelComment[]

  @@index([moderationStatus, publishedAt])
  @@index([creatorId, createdAt])
  @@index([categoryId, moderationStatus, publishedAt])
  @@map("reels")
}

model ReelEngagement {
  id        String         @id @default(uuid()) @db.Uuid
  reelId    String         @map("reel_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EngagementType
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  reel      Reel           @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId, type])
  @@index([userId, type, createdAt])
  @@index([reelId, type, createdAt])
  @@map("reel_engagements")
}

model AuthOtp {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  destination String         @db.VarChar(320)
  purpose     AuthOtpPurpose
  codeHash    String         @map("code_hash") @db.VarChar(64)
  attempts    Int            @default(0)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?      @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otps")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ReelComment {
  id        String   @id @default(uuid()) @db.Uuid
  reelId    String   @map("reel_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reelId, createdAt])
  @@map("reel_comments")
}


model NotificationPreference {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  pushEnabled Boolean @default(true) @map("push_enabled")
  bookingEnabled Boolean @default(true) @map("booking_enabled")
  paymentEnabled Boolean @default(true) @map("payment_enabled")
  chatEnabled Boolean @default(true) @map("chat_enabled")
  reviewEnabled Boolean @default(true) @map("review_enabled")
  disputeEnabled Boolean @default(true) @map("dispute_enabled")
  systemEnabled Boolean @default(true) @map("system_enabled")
  quietHoursStart String? @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd String? @map("quiet_hours_end") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notification_preferences")
}

model PushDevice {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  token String @unique @db.VarChar(1000)
  platform String @db.VarChar(20)
  enabled Boolean @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, enabled])
  @@map("push_devices")
}

model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @map("notification_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  channel String @db.VarChar(20)
  status String @default("PENDING") @db.VarChar(30)
  attemptCount Int @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  lastError String? @map("last_error") @db.VarChar(1000)
  dedupeKey String @unique @map("dedupe_key") @db.VarChar(255)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  subject String @db.VarChar(180)
  description String @db.VarChar(4000)
  category String @db.VarChar(80)
  priority String @default("NORMAL") @db.VarChar(20)
  status String @default("OPEN") @db.VarChar(30)
  resolution String? @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, status, createdAt])
  @@index([status, priority, createdAt])
  @@map("support_tickets")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(160)
  entityType String @map("entity_type") @db.VarChar(80)
  entityId String? @map("entity_id") @db.Uuid
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model SafetyAlert {
  id String @id @default(uuid()) @db.Uuid
  reporterId String @map("reporter_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  severity String @default("HIGH") @db.VarChar(20)
  type String @db.VarChar(80)
  message String @db.VarChar(2000)
  status String @default("OPEN") @db.VarChar(30)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  @@index([status, severity, createdAt])
  @@index([reporterId, createdAt])
  @@map("safety_alerts")
}

model Challenge {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(180)
  description String @db.VarChar(2000)
  rewardPoints Int @default(0) @map("reward_points")
  status String @default("DRAFT") @db.VarChar(30)
  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy User? @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participations ChallengeParticipation[]
  @@index([status, startsAt, endsAt])
  @@map("challenges")
}

model ChallengeParticipation {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  reelId      String?  @map("reel_id") @db.Uuid
  status      String   @default("JOINED") @db.VarChar(30)
  pointsAwarded Int    @default(0) @map("points_awarded")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([challengeId, userId])
  @@index([userId, createdAt])
  @@index([challengeId, status, createdAt])
  @@map("challenge_participations")
}

model SystemConfig {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(120)
  value Json
  description String? @db.VarChar(500)
  updatedBy String? @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("system_config")
}
