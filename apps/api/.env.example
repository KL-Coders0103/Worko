NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081

DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/worko?schema=public"

JWT_ACCESS_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

AUTH_OTP_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

REDIS_URL=redis://127.0.0.1:16379

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET=worko-media

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
WORKO_TEST_PAYMENT_AMOUNT=100
WORKO_DUMMY_PAYMENTS=true

FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
