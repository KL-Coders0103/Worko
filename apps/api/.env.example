# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Database
DATABASE_URL=

# Authentication
JWT_ACCESS_SECRET=
OTP_HASH_SECRET=
PAYMENT_WEBHOOK_SECRET=

# CORS
# Comma-separated browser origins. Native mobile clients do not send a browser Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Google authentication / Gmail OTP delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_EMAIL=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback

# Storage
# The current API implementation uses CloudinaryStorageService.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
