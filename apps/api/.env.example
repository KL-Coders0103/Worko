# ============================================================
# WORKO API - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

NODE_ENV=development

PORT=3000

# API base prefix
# Results in:
# /api/v1/...
API_PREFIX=api

# Comma-separated allowed origins
# For React Native, requests normally do not send a browser Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Swagger is enabled by default outside production.
SWAGGER_ENABLED=true


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME


# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------

# Minimum 32 characters.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Minimum 32 characters.
# Used for hashing OTP values.
OTP_HASH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS


# ------------------------------------------------------------
# GOOGLE AUTHENTICATION
# ------------------------------------------------------------

# Google OAuth client ID used to verify Google ID tokens.
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google OAuth refresh token used by Worko to send OTP emails
# through the Gmail API.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Gmail account used as the Worko OTP sender.
GOOGLE_EMAIL=your-worko-email@gmail.com

# OAuth redirect URI associated with the Google OAuth client.
# This must match the redirect URI configured in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback


# ------------------------------------------------------------
# PAYMENTS
# ------------------------------------------------------------

# Secret used to validate payment webhooks.
# Minimum 32 characters when provided.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_WEBHOOK_SECRET

# Demo payment mode.
#
# development:
# true  = allowed
# false = real/non-demo flow
#
# production:
# MUST be false
PAYMENT_DEMO_ENABLED=false


# ------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------

# Current Worko backend supports Cloudinary storage.
STORAGE_PROVIDER=cloudinary

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret