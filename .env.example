
# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://worko:worko_dev_password@localhost:5432/worko_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_ACCESS_SECRET=replace_with_a_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Security
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=debug
