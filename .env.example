
# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
POSTGRES_USER=worko
POSTGRES_PASSWORD=worko_dev_password
POSTGRES_DB=worko_dev
DATABASE_URL=postgresql://worko:worko_dev_password@localhost:15432/worko_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_URL=redis://127.0.0.1:16379
REDIS_PASSWORD=

# Authentication
JWT_ACCESS_SECRET=replace_with_a_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Supabase Storage (Free)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=worko-media

# Razorpay Payments (Test Mode for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Optional development-only fallback when a verified requirement quote is not stored yet.
WORKO_TEST_PAYMENT_AMOUNT=743
# Development only: keep the real Razorpay integration intact but use the same UI with a server-side dummy payment.
WORKO_DUMMY_PAYMENTS=true

# Security
CORS_ORIGINS=http://localhost:8081

# Logging
LOG_LEVEL=debug

# Firebase Cloud Messaging (server)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
