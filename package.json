{
  "name": "worko",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "Worko - Worker discovery, booking, attendance and workforce management platform",
  "directories": {
    "doc": "docs"
  },
  "workspaces": {
    "packages": [
      "apps/api",
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "keywords": [],
  "author": "Lovesh Bodhani",
  "license": "ISC"
}